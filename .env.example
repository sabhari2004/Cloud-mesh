# CloudMesh Environment Variables Template
# Copy this file to .env and populate with your credentials from the Firebase Console

# =========================================================================
# Firebase Modular Web SDK Configuration
# (Obtained from Firebase Console > Project Settings > General > Your Apps)
# =========================================================================
VITE_FIREBASE_API_KEY=AIzaSyA1234567890abcdefghijklmnopqrst
VITE_FIREBASE_AUTH_DOMAIN=cloudmesh-community.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cloudmesh-community
VITE_FIREBASE_STORAGE_BUCKET=cloudmesh-community.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# =========================================================================
# Optional: Google Gemini AI API Configuration
# (Used for advanced real-time emergency triage & incident summarization)
# =========================================================================
VITE_GEMINI_API_KEY=AIzaSy...
